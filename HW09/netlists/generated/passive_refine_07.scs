// HW09 single-balanced mixer. MOS order: drain gate source body.
simulator lang=spectre
global 0
include "/tools/designkits/NCSU/FreePDK4514/ncsu_basekit/models/hspice/tran_models/models_nom/NMOS_VTH.inc"
// Spectre port amplitude/DC are matched-load values; open-circuit source values are twice these.
RFPORT (rfdrive 0) port r=50 num=1 type=sine dc=0 ampl=0.00056234132519 freq=5800000000 pacmag=0.5 noisetemp=16.85 isnoisy=yes
RFSECOND (rf rfdrive) vsource dc=0 type=sine ampl=0 freq=5800000000
LOP (lop 0) vsource dc=0.6 type=sine ampl=0.2 freq=5600000000 sinephase=0
LON (lon 0) vsource dc=0.6 type=sine ampl=0.2 freq=5600000000 sinephase=180
M1 (outp lop rf 0) NMOS_VTH w=5e-06 l=5e-08 as=5.25e-13 ad=5.25e-13 ps=5.21e-06 pd=5.21e-06 ls=1.05e-07 ld=1.05e-07 m=1
M2 (outn lon rf 0) NMOS_VTH w=5e-06 l=5e-08 as=5.25e-13 ad=5.25e-13 ps=5.21e-06 pd=5.21e-06 ls=1.05e-07 ld=1.05e-07 m=1
R1 (outp 0) resistor r=500
R2 (outn 0) resistor r=500
CLP (outp 0) capacitor c=1e-14
CLN (outn 0) capacitor c=1e-14
simulatorOptions options temp=27 tnom=27 reltol=1e-05 vabstol=1e-9 iabstol=1e-13 gmin=1e-12 digits=12
dcOp dc
dcOpInfo info what=oppoint where=rawfile
save rf rfdrive outp outn lop lon M1:d M2:d LOP:p LON:p RFPORT:p
saveOptions options save=selected currents=selected
tran tran stop=2.5e-08 maxstep=2e-12 strobeperiod=5e-12 errpreset=conservative
